  "keywords": ["postgres", "postgresql", "orm", "sequelize", "n+1", "query", "performance", "profiler", "index", "ci"],
  "bin": { "querylens": "bin/querylens.js" },
  "files": ["bin"],
  "engines": { "node": ">=18" },
  "optionalDependencies": {
    "querylens-cli-darwin-arm64": "0.0.0",
    "querylens-cli-darwin-x64": "0.0.0",
    "querylens-cli-linux-arm64": "0.0.0",
    "querylens-cli-linux-x64": "0.0.0",
    "querylens-cli-win32-x64": "0.0.0"
  }
